# =============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - GROW Deck Automator SEIDOR Perú
# =============================================================================
# Copia este archivo como .env y completa los valores
# =============================================================================

# Proveedor de IA del Chatbot de Preventa: "gemini" (default) o "groq"
# AI_PROVIDER=gemini

# --- Opción A: Google Gemini (AI_PROVIDER=gemini o sin definir) ---
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-api-key-de-gemini-aqui
# Modelo de Gemini (opcional, por defecto gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# --- Opción B: Groq (AI_PROVIDER=groq) ---
# Obtén tu API Key en: https://console.groq.com/keys
# GROQ_API_KEY=tu-api-key-de-groq-aqui
# Modelo de Groq (opcional, por defecto llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Flask configuration
FLASK_SECRET_KEY=cambiar-esta-clave-por-una-segura
FLASK_DEBUG=0

# Token de autenticación para endpoints de API.
# Vacío = autenticación deshabilitada (uso local de un solo consultor).
# Con valor = TODAS las rutas de datos exigen 'Authorization: Bearer <token>',
# incluida la descarga del PPTX. En el navegador se configura una vez con:
#   localStorage.setItem('seidor_api_token', '<token>')
# Recomendado en cualquier despliegue público: sin él, los ids consecutivos
# permiten descargar las propuestas de todos los clientes.
API_TOKEN=

# Base de datos y archivos
DB_NAME=proposals.db
OUTPUT_DIR=generated_decks

# Rate limiting (opcional, valores por defecto)
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX=30

# --- Raspado web del perfil del prospecto ---
# DESACTIVADO a propósito: DuckDuckGo no está en la lista blanca de
# PythonAnywhere y responde 202/timeout fuera de ella, así que el raspado
# fallaba siempre tras gastar ~33 s por propuesta. El perfil se deduce del
# nombre de la empresa, que es instantáneo y más fiable.
# SCRAPER_ENABLED=0
# SCRAPER_TIMEOUT=6
# SCRAPER_MAX_RETRIES=3

# --- CORS ---
# Vacío = solo mismo origen (recomendado: la UI se sirve desde este mismo Flask).
# Rellenar SOLO si un frontend externo debe consumir la API.
# CORS_ORIGINS=https://mi-frontend.example
